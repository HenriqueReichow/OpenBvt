#!/bin/sh
# opensonar postinst: creates the opensonar-net network profile and opens the .aris family ports in
# ufw when it is active (the only steps that need root).
set -e
PROFILE=opensonar-net
ADDRESSES=192.168.1.10/24,169.254.10.10/16      # P900/M900 subnet + link-local (.aris family); no gateway
if [ "$1" = "configure" ]; then
    if command -v nmcli >/dev/null 2>&1 && nmcli -t general status >/dev/null 2>&1; then
        if nmcli -t -f NAME connection show | grep -qx "$PROFILE"; then
            # an older install had only the first address
            nmcli connection modify "$PROFILE" ipv4.addresses "$ADDRESSES" ipv4.gateway "" \
                ipv4.never-default yes >/dev/null 2>&1 \
                && echo "opensonar: network profile $PROFILE set to $ADDRESSES" || true
        else
            DEV=$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="ethernet"{print $1; exit}')
            if [ -n "$DEV" ]; then
                nmcli connection add type ethernet con-name "$PROFILE" ifname "$DEV" \
                    ipv4.method manual ipv4.addresses "$ADDRESSES" ipv4.never-default yes \
                    ipv6.method disabled connection.autoconnect no >/dev/null \
                    && echo "opensonar: created the network profile $PROFILE ($ADDRESSES on $DEV)"
            else
                echo "opensonar: no wired card found; the GUI button 'Configure sonar network' creates the profile later"
            fi
        fi
    else
        echo "opensonar: NetworkManager is not running; the GUI button 'Configure sonar network' creates the profile later"
    fi
    # .aris family: beacons (UDP 56124) and frames (UDP 56125, the port the service asks for)
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "^Status: active"; then
        ufw allow 56124/udp comment "opensonar beacons" >/dev/null 2>&1 || true
        ufw allow 56125/udp comment "opensonar frames" >/dev/null 2>&1 || true
        echo "opensonar: ufw allows UDP 56124 and 56125"
    fi
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
    command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
fi
exit 0
